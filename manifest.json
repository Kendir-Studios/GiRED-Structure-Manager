{
  "manifest_version": 3,
  "name": "GiRED Structure Mapper",
  "version": "1.4.1",
  "description": "Adiciona numeração SA/AT ao GiRED e mantém o contexto da atividade durante a navegação e entre tabs.",
  "key": "",
  "permissions": ["storage", "nativeMessaging"],
  "action": {
    "default_title": "GiRED Structure Mapper",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://apps.gired.pt/*", "https://cms.gired.pt/*"],
    "js": ["toggle-control.js", "content.js", "cms-dropdowns.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}
