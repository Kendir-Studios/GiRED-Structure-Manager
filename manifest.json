{
  "manifest_version": 3,
  "name": "GiRED Structure Mapper",
  "version": "1.3.1",
  "description": "Adiciona numeração SA/AT ao GiRED e mantém o contexto da atividade durante a navegação.",
  "content_scripts": [
    {
      "matches": [
        "https://apps.gired.pt/authoring/course/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
