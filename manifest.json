{
  "manifest_version": 3,
  "name": "GiRED Fixer",
  "version": "2.6.2",
  "description": "Adiciona numeração SA/AT ao GiRED e mantém o contexto da atividade durante a navegação e entre tabs.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GiRED Fixer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://apps.gired.pt/*",
        "https://cms.gired.pt/*"
      ],
      "js": [
        "toggle-control.js",
        "review-sidebar-control.js",
        "version-sidebar-control.js",
        "version-comments-search.js",
        "version-vc-counters.js",
        "version-comment-location-pill.js",
        "content.js",
        "cms-dropdowns.js",
        "cms-code-editor.js",
        "cms-sequence-nav.js",
        "cms-quick-add.js",
        "cms-json-download.js"
      ],
      "css": [
        "styles.css",
        "version-sidebar.css",
        "context-hide.css",
        "cms-editor-modal.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://apps.gired.pt/*",
        "https://cms.gired.pt/*"
      ],
      "js": [
        "version-comments-export.js",
        "version-comments-export-links.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
